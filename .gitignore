# dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# build artifacts
frontend/dist/
frontend/build/

# environment files (keep example, ignore real)
.env
backend/.env
frontend/.env
*.env.local

# uploads (user data)
backend/uploads/assignments/*
backend/uploads/submissions/*
backend/uploads/avatars/*
!backend/uploads/assignments/.gitkeep
!backend/uploads/submissions/.gitkeep
!backend/uploads/avatars/.gitkeep

# logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pm2.log
.pm2/

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# coverage / test
coverage/
.nyc_output/

# pem / secrets — never commit
*.pem
*.key
