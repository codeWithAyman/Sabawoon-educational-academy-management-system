{
  "name": "sabawoon-academy",
  "productName": "Sabawoon Educational Academy",
  "version": "1.1.1",
  "private": true,
  "description": "Sabawoon Educational Academy Management System — Windows desktop application (Electron wrapping the existing React + Express + PostgreSQL stack)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run start",
    "build:frontend": "npm --prefix frontend run build",
    "start": "npm run build:frontend && electron .",
    "electron": "electron .",
    "electron:dev": "cross-env ELECTRON_RENDERER_URL=http://localhost:5173 electron .",
    "verify:backend-deps": "node scripts/verify-backend-deps.cjs",
    "backup:scheduled": "node backend/src/services/run-scheduled-backup.cjs",
    "prepare:backend": "npm --prefix backend ci --omit=dev && npm run verify:backend-deps",
    "dist:win": "npm run prepare:backend && npm run build:frontend && electron-builder --win",
    "pack:win": "npm run prepare:backend && npm run build:frontend && electron-builder --win --dir"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.sabawoon.academy",
    "productName": "Sabawoon Educational Academy",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "electron/**"
    ],
    "extraResources": [
      {
        "from": "backend",
        "to": "backend",
        "filter": [
          "**/*",
          "!**/.env*",
          "!backups/**",
          "!uploads/**",
          "!**/.test-token",
          "!**/*.log",
          "!**/*.pid"
        ]
      },
      {
        "from": "frontend/dist",
        "to": "frontend/dist"
      },
      {
        "from": "build/provision.ps1",
        "to": "provision.ps1"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "include": "build/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Sabawoon Academy"
    },
    "extraMetadata": {
      "main": "electron/main.cjs"
    }
  }
}
