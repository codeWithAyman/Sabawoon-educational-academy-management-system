import { useEffect, useState } from "react";
import api from "../lib/api";
import { useToast } from "../components/Toast";
import {
  Plus,
  Pencil,
  Trash2,
  X,
  Loader2,
  Users,
  UserRound,
  ShieldCheck,
  BriefcaseBusiness,
  Mail,
  Lock,
  Phone,
  UserCheck,
  ArrowRight,
} from "lucide-react";

const roleConfig = {
  teacher: {
    label: "Teachers",
    singular: "Teacher",
    icon: UserRound,
    description: "Teaching staff and system access.",
  },
  staff: {
    label: "Staff",
    singular: "Staff",
    icon: BriefcaseBusiness,
    description: "Administrative and support staff.",
  },
  admin: {
    label: "Administrators",
    singular: "Admin",
    icon: ShieldCheck,
    description: "Administrator accounts and access.",
  },
};

export default function UsersPage() {
  const toast = useToast();

  const [rows, setRows] = useState(null);
  const [role, setRole] = useState("teacher");
  const [modal, setModal] = useState(null);

  async function load() {
    try {
      const { data } = await api.get(`/users?role=${role}`);
      setRows(data);
    } catch (e) {
      toast.error(e.response?.data?.error || "Failed to load users");
      setRows([]);
    }
  }

  useEffect(() => {
    load();
  }, [role]);

  async function save(form) {
    try {
      if (modal.id) {
        await api.put(`/users/${modal.id}`, form);
      } else {
        await api.post("/users", { ...form, role });
      }

      toast.success("Saved successfully");
      setModal(null);
      load();
    } catch (e) {
      toast.error(e.response?.data?.error || "Save failed");
    }
  }

  async function del(id) {
    if (!confirm("Delete this user?")) return;

    try {
      await api.delete(`/users/${id}`);
      toast.success("User deleted");
      load();
    } catch (e) {
      toast.error(e.response?.data?.error || "Delete failed");
    }
  }

  const config = roleConfig[role];
  const RoleIcon = config.icon;

  return (
    <div className="relative min-h-full">
      {/* Background ambience */}
      <div className="pointer-events-none fixed inset-0 overflow-hidden">
        <div className="absolute right-[5%] top-[-220px] h-[450px] w-[450px] rounded-full bg-[#f2bd19]/[0.022] blur-[120px]" />
        <div className="absolute bottom-[-250px] left-[8%] h-[450px] w-[450px] rounded-full bg-white/[0.01] blur-[120px]" />
      </div>

      <div
        className="pointer-events-none fixed inset-0 opacity-[0.015]"
        style={{
          backgroundImage:
            "linear-gradient(rgba(255,255,255,0.4) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.4) 1px, transparent 1px)",
          backgroundSize: "48px 48px",
        }}
      />

      <div className="relative z-10 space-y-4">
        {/* Header */}
        <div className="flex items-center justify-between gap-4">
          <div className="min-w-0">
            <div className="mb-1.5 flex items-center gap-2">
              <div className="flex h-7 w-7 items-center justify-center rounded-lg border border-[#f2bd19]/15 bg-[#f2bd19]/10">
                <Users className="h-3.5 w-3.5 text-[#f2bd19]" />
              </div>

              <span className="text-[9px] font-semibold uppercase tracking-[0.18em] text-slate-600">
                User Management
              </span>
            </div>

            <h1 className="text-[24px] font-semibold leading-none tracking-[-0.025em] text-white">
              Teachers & Staff
            </h1>

            <p className="mt-1.5 text-[11px] text-slate-600">
              Manage staff accounts and system access.
            </p>
          </div>

          <button
            type="button"
            onClick={() => setModal({})}
            className="group inline-flex h-9 shrink-0 items-center gap-1.5 rounded-lg bg-[#f2bd19] px-3.5 text-[11px] font-bold text-[#111] shadow-[0_7px_20px_rgba(242,189,25,0.11)] transition-all hover:bg-[#e6b317] hover:shadow-[0_9px_25px_rgba(242,189,25,0.18)] active:bg-[#d9a912]"
            data-testid="user-add"
          >
            <Plus className="h-3.5 w-3.5" />
            Add {config.singular}
            <ArrowRight className="h-3 w-3 transition-transform group-hover:translate-x-0.5" />
          </button>
        </div>

        {/* Role tabs */}
        <div className="rounded-lg border border-white/[0.07] bg-[#121519] p-1 shadow-[0_10px_35px_rgba(0,0,0,0.14)]">
          <div className="flex gap-1">
            {["teacher", "staff", "admin"].map((r) => {
              const item = roleConfig[r];
              const Icon = item.icon;
              const active = role === r;

              return (
                <button
                  key={r}
                  type="button"
                  onClick={() => setRole(r)}
                  className={`relative flex h-9 flex-1 items-center justify-center gap-2 rounded-md text-[11px] font-semibold transition-all ${
                    active
                      ? "bg-[#f2bd19]/10 text-[#f2bd19]"
                      : "text-slate-600 hover:bg-white/[0.025] hover:text-slate-400"
                  }`}
                  data-testid={`tab-${r}`}
                >
                  <Icon className="h-3.5 w-3.5" />
                  {item.label}

                  {active && (
                    <span className="absolute bottom-0 left-1/2 h-[2px] w-7 -translate-x-1/2 rounded-full bg-[#f2bd19]" />
                  )}
                </button>
              );
            })}
          </div>
        </div>

        {/* Small stats */}
        <div className="grid grid-cols-3 gap-3">
          <div className="flex h-[68px] items-center gap-3 rounded-lg border border-white/[0.07] bg-[#121519] px-3.5 shadow-[0_10px_30px_rgba(0,0,0,0.12)]">
            <div className="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-[#f2bd19]/15 bg-[#f2bd19]/[0.07]">
              <RoleIcon className="h-3.5 w-3.5 text-[#f2bd19]" />
            </div>

            <div className="min-w-0">
              <p className="text-[8px] font-semibold uppercase tracking-[0.12em] text-slate-600">
                Section
              </p>
              <p className="mt-0.5 truncate text-[11px] font-semibold text-slate-300">
                {config.label}
              </p>
            </div>
          </div>

          <div className="flex h-[68px] items-center gap-3 rounded-lg border border-white/[0.07] bg-[#121519] px-3.5 shadow-[0_10px_30px_rgba(0,0,0,0.12)]">
            <div className="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-emerald-400/15 bg-emerald-400/[0.06]">
              <Users className="h-3.5 w-3.5 text-emerald-400" />
            </div>

            <div>
              <p className="text-[8px] font-semibold uppercase tracking-[0.12em] text-slate-600">
                Total
              </p>
              <p className="mt-0.5 text-[11px] font-semibold text-slate-300">
                {rows ? rows.length : "—"}
              </p>
            </div>
          </div>

          <div className="flex h-[68px] items-center gap-3 rounded-lg border border-white/[0.07] bg-[#121519] px-3.5 shadow-[0_10px_30px_rgba(0,0,0,0.12)]">
            <div className="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-blue-400/15 bg-blue-400/[0.06]">
              <ShieldCheck className="h-3.5 w-3.5 text-blue-400" />
            </div>

            <div>
              <p className="text-[8px] font-semibold uppercase tracking-[0.12em] text-slate-600">
                Access
              </p>
              <p className="mt-0.5 text-[11px] font-semibold text-slate-300">
                Authorized
              </p>
            </div>
          </div>
        </div>

        {/* Main table card */}
        <div className="overflow-hidden rounded-lg border border-white/[0.07] bg-[#121519] shadow-[0_15px_45px_rgba(0,0,0,0.17)]">
          {/* Table header */}
          <div className="flex items-center justify-between border-b border-white/[0.06] px-4 py-3">
            <div className="flex items-center gap-2.5">
              <div className="flex h-7 w-7 items-center justify-center rounded-md border border-white/[0.07] bg-white/[0.025]">
                <RoleIcon className="h-3.5 w-3.5 text-slate-500" />
              </div>

              <div>
                <div className="flex items-center gap-2">
                  <h2 className="text-[11px] font-semibold text-slate-300">
                    {config.label}
                  </h2>

                  {rows && (
                    <span className="rounded-full border border-white/[0.07] bg-white/[0.025] px-1.5 py-0.5 text-[8px] font-semibold text-slate-600">
                      {rows.length}
                    </span>
                  )}
                </div>

                <p className="mt-0.5 text-[9px] text-slate-700">
                  {config.description}
                </p>
              </div>
            </div>

            <div className="hidden items-center gap-1.5 sm:flex">
              <span className="h-1.5 w-1.5 rounded-full bg-emerald-400 shadow-[0_0_7px_rgba(52,211,153,0.6)]" />
              <span className="text-[9px] text-slate-700">
                Access management
              </span>
            </div>
          </div>

          {/* Loading */}
          {!rows && (
            <div className="grid min-h-[260px] place-items-center">
              <div className="flex flex-col items-center">
                <div className="mb-2.5 flex h-9 w-9 items-center justify-center rounded-lg border border-white/[0.07] bg-white/[0.025]">
                  <Loader2 className="h-4 w-4 animate-spin text-[#f2bd19]" />
                </div>

                <p className="text-[10px] text-slate-700">Loading users...</p>
              </div>
            </div>
          )}

          {/* Empty */}
          {rows && rows.length === 0 && (
            <div className="grid min-h-[260px] place-items-center px-5">
              <div className="text-center">
                <div className="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl border border-white/[0.07] bg-white/[0.025]">
                  <Users className="h-5 w-5 text-slate-700" />
                </div>

                <h3 className="text-[12px] font-semibold text-slate-400">
                  No {config.label.toLowerCase()} yet
                </h3>

                <p className="mx-auto mt-1 max-w-[280px] text-[10px] leading-4 text-slate-700">
                  Add your first {config.singular.toLowerCase()} to give them
                  system access.
                </p>

                <button
                  type="button"
                  onClick={() => setModal({})}
                  className="mt-3 inline-flex h-8 items-center gap-1.5 rounded-md border border-[#f2bd19]/15 bg-[#f2bd19]/[0.06] px-3 text-[10px] font-semibold text-[#f2bd19] transition-colors hover:bg-[#f2bd19]/[0.1]"
                >
                  <Plus className="h-3 w-3" />
                  Add {config.singular}
                </button>
              </div>
            </div>
          )}

          {/* Table */}
          {rows && rows.length > 0 && (
            <div className="overflow-x-auto">
              <table className="w-full min-w-[680px]">
                <thead>
                  <tr className="border-b border-white/[0.05] bg-white/[0.01]">
                    <th className="px-4 py-2.5 text-left text-[8px] font-semibold uppercase tracking-[0.14em] text-slate-700">
                      Name
                    </th>

                    <th className="px-4 py-2.5 text-left text-[8px] font-semibold uppercase tracking-[0.14em] text-slate-700">
                      Email
                    </th>

                    <th className="px-4 py-2.5 text-left text-[8px] font-semibold uppercase tracking-[0.14em] text-slate-700">
                      Phone
                    </th>

                    <th className="px-4 py-2.5 text-left text-[8px] font-semibold uppercase tracking-[0.14em] text-slate-700">
                      Status
                    </th>

                    <th className="px-4 py-2.5 text-right text-[8px] font-semibold uppercase tracking-[0.14em] text-slate-700">
                      Actions
                    </th>
                  </tr>
                </thead>

                <tbody className="divide-y divide-white/[0.04]">
                  {rows.map((r) => (
                    <tr
                      key={r.id}
                      className="group transition-colors hover:bg-white/[0.016]"
                    >
                      {/* Name */}
                      <td className="px-4 py-3">
                        <div className="flex items-center gap-2.5">
                          <div className="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg border border-white/[0.07] bg-[#0d1013] text-[9px] font-bold text-[#f2bd19]">
                            {r.full_name
                              ?.split(" ")
                              .map((x) => x[0])
                              .slice(0, 2)
                              .join("")
                              .toUpperCase() || "?"}
                          </div>

                          <div className="min-w-0">
                            <p className="truncate text-[11px] font-semibold text-slate-300">
                              {r.full_name}
                            </p>

                            <p className="mt-0.5 text-[8px] uppercase tracking-[0.08em] text-slate-700">
                              {role}
                            </p>
                          </div>
                        </div>
                      </td>

                      {/* Email */}
                      <td className="px-4 py-3">
                        <div className="flex items-center gap-2">
                          <Mail className="h-3 w-3 shrink-0 text-slate-700" />

                          <span className="text-[10px] text-slate-500">
                            {r.email}
                          </span>
                        </div>
                      </td>

                      {/* Phone */}
                      <td className="px-4 py-3">
                        <div className="flex items-center gap-2">
                          <Phone className="h-3 w-3 shrink-0 text-slate-700" />

                          <span className="text-[10px] text-slate-500">
                            {r.phone || "-"}
                          </span>
                        </div>
                      </td>

                      {/* Status */}
                      <td className="px-4 py-3">
                        <span
                          className={`inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-[8px] font-semibold ${
                            r.is_active
                              ? "border-emerald-400/15 bg-emerald-400/[0.06] text-emerald-400"
                              : "border-white/[0.06] bg-white/[0.02] text-slate-600"
                          }`}
                        >
                          <span
                            className={`h-1.5 w-1.5 rounded-full ${
                              r.is_active
                                ? "bg-emerald-400 shadow-[0_0_6px_rgba(52,211,153,0.55)]"
                                : "bg-slate-700"
                            }`}
                          />

                          {r.is_active ? "Active" : "Inactive"}
                        </span>
                      </td>

                      {/* Actions */}
                      <td className="px-4 py-3 text-right">
                        <div className="flex items-center justify-end gap-0.5">
                          <button
                            type="button"
                            onClick={() => setModal(r)}
                            className="flex h-7 w-7 items-center justify-center rounded-md text-slate-700 transition-all hover:bg-[#f2bd19]/[0.07] hover:text-[#f2bd19]"
                            title="Edit"
                          >
                            <Pencil className="h-3 w-3" />
                          </button>

                          <button
                            type="button"
                            onClick={() => del(r.id)}
                            className="flex h-7 w-7 items-center justify-center rounded-md text-slate-700 transition-all hover:bg-red-400/[0.07] hover:text-red-400"
                            title="Delete"
                          >
                            <Trash2 className="h-3 w-3" />
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
      </div>

      {modal && (
        <UserModal
          role={role}
          initial={modal}
          onClose={() => setModal(null)}
          onSave={save}
        />
      )}
    </div>
  );
}

function UserModal({ role, initial, onClose, onSave }) {
  const isEdit = !!initial.id;

  const [f, setF] = useState({
    email: initial.email || "",
    password: "",
    full_name: initial.full_name || "",
    phone: initial.phone || "",
    is_active: initial.is_active ?? true,
  });

  const [saving, setSaving] = useState(false);

  const config = roleConfig[role];
  const RoleIcon = config.icon;

  const upd = (key) => (e) => {
    setF({
      ...f,
      [key]: key === "is_active" ? e.target.checked : e.target.value,
    });
  };

  async function submit(e) {
    e.preventDefault();

    setSaving(true);

    const d = { ...f };

    if (isEdit) {
      delete d.email;

      if (!d.password) {
        delete d.password;
      }
    }

    try {
      await onSave(d);
    } finally {
      setSaving(false);
    }
  }

  return (
    <div
      className="fixed inset-0 z-50 grid place-items-center bg-black/70 p-4 backdrop-blur-[3px]"
      onClick={onClose}
    >
      <form
        onSubmit={submit}
        onClick={(e) => e.stopPropagation()}
        className="relative w-full max-w-[430px] overflow-hidden rounded-xl border border-white/[0.09] bg-[#121519] shadow-[0_30px_90px_rgba(0,0,0,0.55)]"
      >
        {/* Gold line */}
        <div className="h-[2px] w-full bg-[#f2bd19]" />

        {/* Modal header */}
        <div className="flex items-center border-b border-white/[0.06] px-5 py-4">
          <div className="flex items-center gap-2.5">
            <div className="flex h-9 w-9 items-center justify-center rounded-lg border border-[#f2bd19]/15 bg-[#f2bd19]/10">
              <RoleIcon className="h-4 w-4 text-[#f2bd19]" />
            </div>

            <div>
              <h3 className="text-[13px] font-semibold text-white">
                {isEdit ? `Edit ${config.singular}` : `Add ${config.singular}`}
              </h3>

              <p className="mt-0.5 text-[9px] text-slate-600">
                {isEdit
                  ? "Update account information."
                  : `Create a new ${config.singular.toLowerCase()} account.`}
              </p>
            </div>
          </div>

          <button
            type="button"
            onClick={onClose}
            className="ml-auto flex h-7 w-7 items-center justify-center rounded-md text-slate-700 transition-colors hover:bg-white/[0.04] hover:text-slate-400"
          >
            <X className="h-3.5 w-3.5" />
          </button>
        </div>

        {/* Form */}
        <div className="space-y-3.5 p-5">
          {/* Full name */}
          <div>
            <label className="mb-1.5 block text-[9px] font-semibold uppercase tracking-[0.1em] text-slate-600">
              Full name *
            </label>

            <div className="relative group">
              <UserRound className="pointer-events-none absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-slate-700 transition-colors group-focus-within:text-[#f2bd19]" />

              <input
                required
                autoFocus
                value={f.full_name}
                onChange={upd("full_name")}
                placeholder="Enter full name"
                className="h-10 w-full rounded-lg border border-white/[0.08] bg-[#0d1013] pl-9 pr-3 text-[11px] text-slate-300 outline-none transition-all placeholder:text-slate-700 hover:border-white/[0.12] focus:border-[#f2bd19]/50 focus:ring-2 focus:ring-[#f2bd19]/10"
              />
            </div>
          </div>

          {/* Email */}
          <div>
            <label className="mb-1.5 block text-[9px] font-semibold uppercase tracking-[0.1em] text-slate-600">
              Email *
            </label>

            <div className="relative group">
              <Mail className="pointer-events-none absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-slate-700 transition-colors group-focus-within:text-[#f2bd19]" />

              <input
                type="email"
                required
                disabled={isEdit}
                value={f.email}
                onChange={upd("email")}
                placeholder="name@example.com"
                className={`h-10 w-full rounded-lg border border-white/[0.08] bg-[#0d1013] pl-9 pr-3 text-[11px] text-slate-300 outline-none transition-all placeholder:text-slate-700 hover:border-white/[0.12] focus:border-[#f2bd19]/50 focus:ring-2 focus:ring-[#f2bd19]/10 ${
                  isEdit ? "cursor-not-allowed opacity-45" : ""
                }`}
              />
            </div>

            {isEdit && (
              <p className="mt-1 text-[8px] text-slate-700">
                Email cannot be changed after creation.
              </p>
            )}
          </div>

          {/* Password */}
          <div>
            <label className="mb-1.5 block text-[9px] font-semibold uppercase tracking-[0.1em] text-slate-600">
              {isEdit ? "New password" : "Password *"}
            </label>

            <div className="relative group">
              <Lock className="pointer-events-none absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-slate-700 transition-colors group-focus-within:text-[#f2bd19]" />

              <input
                type="password"
                minLength={isEdit ? 0 : 6}
                required={!isEdit}
                value={f.password}
                onChange={upd("password")}
                placeholder={
                  isEdit
                    ? "Leave blank to keep current password"
                    : "Minimum 6 characters"
                }
                className="h-10 w-full rounded-lg border border-white/[0.08] bg-[#0d1013] pl-9 pr-3 text-[11px] text-slate-300 outline-none transition-all placeholder:text-slate-700 hover:border-white/[0.12] focus:border-[#f2bd19]/50 focus:ring-2 focus:ring-[#f2bd19]/10"
              />
            </div>

            {isEdit && (
              <p className="mt-1 text-[8px] text-slate-700">
                Leave blank to keep the current password.
              </p>
            )}
          </div>

          {/* Phone */}
          <div>
            <label className="mb-1.5 block text-[9px] font-semibold uppercase tracking-[0.1em] text-slate-600">
              Phone
            </label>

            <div className="relative group">
              <Phone className="pointer-events-none absolute left-3 top-1/2 h-3.5 w-3.5 -translate-y-1/2 text-slate-700 transition-colors group-focus-within:text-[#f2bd19]" />

              <input
                value={f.phone}
                onChange={upd("phone")}
                placeholder="Phone number"
                className="h-10 w-full rounded-lg border border-white/[0.08] bg-[#0d1013] pl-9 pr-3 text-[11px] text-slate-300 outline-none transition-all placeholder:text-slate-700 hover:border-white/[0.12] focus:border-[#f2bd19]/50 focus:ring-2 focus:ring-[#f2bd19]/10"
              />
            </div>
          </div>

          {/* Active toggle */}
          {isEdit && (
            <div className="rounded-lg border border-white/[0.06] bg-[#0d1013] px-3 py-2.5">
              <label className="flex cursor-pointer items-center justify-between">
                <div className="flex items-center gap-2.5">
                  <div className="flex h-7 w-7 items-center justify-center rounded-md border border-emerald-400/10 bg-emerald-400/[0.05]">
                    <UserCheck className="h-3 w-3 text-emerald-400" />
                  </div>

                  <div>
                    <p className="text-[10px] font-semibold text-slate-400">
                      Account active
                    </p>

                    <p className="mt-0.5 text-[8px] text-slate-700">
                      Allow system access.
                    </p>
                  </div>
                </div>

                <div className="relative">
                  <input
                    type="checkbox"
                    checked={f.is_active}
                    onChange={upd("is_active")}
                    className="peer sr-only"
                  />

                  <div className="h-[18px] w-8 rounded-full bg-slate-700 transition-colors peer-checked:bg-[#f2bd19]" />

                  <div className="absolute left-0.5 top-0.5 h-[14px] w-[14px] rounded-full bg-white shadow-sm transition-transform peer-checked:translate-x-[14px]" />
                </div>
              </label>
            </div>
          )}
        </div>

        {/* Footer */}
        <div className="flex items-center justify-end gap-2 border-t border-white/[0.06] bg-[#0d1013] px-5 py-3">
          <button
            type="button"
            onClick={onClose}
            disabled={saving}
            className="h-9 rounded-lg border border-white/[0.08] bg-white/[0.02] px-3.5 text-[10px] font-semibold text-slate-600 transition-all hover:border-white/[0.12] hover:bg-white/[0.04] hover:text-slate-400 disabled:opacity-50"
          >
            Cancel
          </button>

          <button
            type="submit"
            disabled={saving}
            className="inline-flex h-9 items-center gap-1.5 rounded-lg bg-[#f2bd19] px-4 text-[10px] font-bold text-[#111] shadow-[0_6px_18px_rgba(242,189,25,0.11)] transition-all hover:bg-[#e6b317] hover:shadow-[0_8px_22px_rgba(242,189,25,0.18)] disabled:cursor-not-allowed disabled:opacity-60"
          >
            {saving ? (
              <>
                <Loader2 className="h-3 w-3 animate-spin" />
                Saving...
              </>
            ) : (
              <>
                {isEdit ? "Save changes" : "Create user"}
                <ArrowRight className="h-3 w-3" />
              </>
            )}
          </button>
        </div>
      </form>
    </div>
  );
}
