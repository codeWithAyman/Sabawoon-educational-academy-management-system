PORT=5478
NODE_ENV=production
DATABASE_URL=postgresql://hm_user:CHANGE_ME@localhost:5432/hm_sms
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@hmsms.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Administrator
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ---- CORS (normally NOT needed) -------------------------------------------
# The frontend is served by this same server (PC, phone and tablet browsers
# all use http://<PC-IP>:5478), so every request is same-origin and CORS
# stays disabled. Only set CORS_ORIGIN if you deliberately host the frontend
# on a different origin during development, e.g. CORS_ORIGIN=http://localhost:5173
# Never use * in production.
# CORS_ORIGIN=

# ---- Database Backups -----------------------------------------------------
# Installed application version (shown on the backup page).
APP_VERSION=1.0.3

# Directory where database backup files (.dump) are stored on the server.
# Must be on the same PC that hosts PostgreSQL.
# Default: backend/backups in development; the installed desktop app uses
# %APPDATA%\Sabawoon Educational Academy\backups (outside the install
# folder, so backups survive updates and reinstalls).
BACKUP_DIR=./backups

# Full path to the folder containing pg_dump / pg_restore (the PostgreSQL
# "bin" directory). Leave empty to auto-detect common install locations
# (Windows: C:\Program Files\PostgreSQL\17\bin, Linux: /usr/bin, ...).
PG_BIN_DIR=

# Optional superuser connection string (e.g. the "postgres" account).
# When set, restores first test the backup inside a temporary database created
# with this account before touching the live database. Leave empty to skip the
# pre-flight test database (the restore still runs in a single transaction).
# PG_ADMIN_URL=postgresql://postgres:CHANGE_ME@localhost:5432/postgres

# ---- Automatic daily backups ----------------------------------------------
# Time of day (local PC time, 24h HH:MM) when the automatic backup runs.
# Missed days (computer switched off) are caught up the next time the
# application or the Windows scheduled task runs.
BACKUP_DAILY_AT=04:00

# Set to 0 to disable the in-application automatic backup scheduler.
BACKUP_AUTOMATIC=1

# How many backups to keep: the newest per day for the last N days, plus the
# newest per month for the last M months. The newest backup is never deleted.
BACKUP_RETENTION_DAILY=30
BACKUP_RETENTION_MONTHLY=12

# NOTE: the old update-checking keys (GITHUB_RELEASE_REPO*) were removed
# together with the application update feature. They are no longer read.
