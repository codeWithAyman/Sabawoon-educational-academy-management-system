PORT=5478
NODE_ENV=production
DATABASE_URL=postgresql://hm_user:CHANGE_ME@localhost:5432/hm_sms
JWT_SECRET=CHANGE_ME_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@hmsms.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=System Administrator
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
CORS_ORIGIN=*

# ---- Updates & Backup page -------------------------------------------------
# Installed application version reported to the update checker.
# Set this to the version of the release you have deployed (e.g. 0.9.1).
APP_VERSION=1.0.0

# Directory where database backup files (.dump) are stored on the server.
# Must be on the same PC that hosts PostgreSQL. Default: backend/backups
BACKUP_DIR=./backups

# Full path to the folder containing pg_dump / pg_restore (the PostgreSQL
# "bin" directory). Leave empty to auto-detect common install locations
# (Windows: C:\Program Files\PostgreSQL\17\bin, Linux: /usr/bin, ...).
PG_BIN_DIR=

# Optional superuser connection string (e.g. the "postgres" account).
# When set, restores first test the backup inside a temporary database created
# with this account before touching the live database. Leave empty to skip the
# pre-flight test database (the restore still runs in a single transaction).
# PG_ADMIN_URL=postgresql://postgres:CHANGE_ME@localhost:5432/postgres

# ---- GitHub (Updates & Backup page) ----------------------------------------
# A fine-grained or classic personal access token with "repo" scope.
# It is read ONLY by the backend and must never be committed or sent to the
# browser. Leave empty to disable GitHub upload / update checks.
GITHUB_TOKEN=

# PRIVATE repository that receives database backup files as release assets
# (assets are stored outside ordinary Git history). Create a private repo,
# e.g. https://github.com/<you>/sabawoon-db-backups, then set:
GITHUB_BACKUP_REPO_OWNER=
GITHUB_BACKUP_REPO_NAME=
# (Alternatively set GITHUB_BACKUP_REPO=owner/name as a single value.)

# Repository whose GitHub Releases are treated as official application
# updates. Leave empty to disable the update check.
GITHUB_RELEASE_REPO_OWNER=
GITHUB_RELEASE_REPO_NAME=
# (Alternatively set GITHUB_RELEASE_REPO=owner/name as a single value.)
